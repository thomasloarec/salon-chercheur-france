{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/rebuild",
      "schedule": "0 4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/ville/villepinte",
      "destination": "/ville/paris",
      "permanent": true
    },
    {
      "source": "/ville/villepinte/:year",
      "destination": "/ville/paris/:year",
      "permanent": true
    },
    {
      "source": "/ville/chassieu",
      "destination": "/ville/lyon",
      "permanent": true
    },
    {
      "source": "/ville/chassieu/:year",
      "destination": "/ville/lyon/:year",
      "permanent": true
    },
    {
      "source": "/ville/bruz",
      "destination": "/ville/rennes",
      "permanent": true
    },
    {
      "source": "/ville/bruz/:year",
      "destination": "/ville/rennes/:year",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-exposants.xml",
      "destination": "https://vxivdvzzhebobveedxbj.supabase.co/functions/v1/sitemap-exposants"
    },
    {
      "source": "/invitation/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(LinkedInBot|linkedinbot|facebookexternalhit|Facebot|Twitterbot|Slackbot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|MicrosoftPreview|Teams|Googlebot|bingbot|Applebot|Pinterest|redditbot|Embedly).*"
        }
      ],
      "destination": "/api/invitation-og?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}